# ============================================================
# Environment / dotenv files
# ------------------------------------------------------------
# Real secrets must NEVER be committed. Only the *.example
# template files should be tracked so teammates know which
# keys are required.
# ============================================================

# --- Generic dotenv files ---
.env
.env.*.local
.env.local
.env.keys
!.env.example

# --- Cloudflare Worker secrets (uploaded via `wrangler secret bulk`) ---
*.env
!*.env.example

# --- Cloudflare Worker plaintext deploy variables (`--var KEY:VALUE`) ---
*.vars.env
!*.vars.env.example

# --- Cloudflare local development secrets (wrangler dev) ---
.dev.vars*
!.dev.vars.example

# --- Rotation backups from rotate-secrets.sh ---
# Contains secret NAMES only, but still shouldn't be committed.
.secret-backups/

